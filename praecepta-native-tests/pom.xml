<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.brunopacheco1</groupId>
        <artifactId>praecepta</artifactId>
        <version>0.7.0-SNAPSHOT</version>
    </parent>
    <artifactId>praecepta-native-tests</artifactId>
    <packaging>pom</packaging>
    <name>praecepta-native-tests</name>
    <description>
        The framework integrations as GraalVM native executables (#99): src/it holds one small application per
        framework (Spring Boot, Micronaut, Quarkus), each built natively with the framework's own tooling, run,
        and made to evaluate decisions through the injected beans. A reactor module only with the
        native-frameworks profile, which the native-frameworks workflow enables; never published.
    </description>

    <properties>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- left out of the Maven Central bundle (central-publishing-maven-plugin) -->
        <skipPublishing>true</skipPublishing>
        <jacoco.skip>true</jacoco.skip>
        <!-- not published: no SBOM -->
        <cyclonedx.skip>true</cyclonedx.skip>
    </properties>

    <!--
        The modules the applications use, so that the reactor builds them first and the invoker installs them into
        its own repository (target/it-repo). Nothing of theirs is needed here: the applications resolve the
        frameworks themselves, as user projects do.
    -->
    <dependencies>
        <dependency>
            <groupId>io.github.brunopacheco1</groupId>
            <artifactId>praecepta-engine</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.github.brunopacheco1</groupId>
            <artifactId>praecepta-loader</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.github.brunopacheco1</groupId>
            <artifactId>praecepta-compiler</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.github.brunopacheco1</groupId>
            <artifactId>praecepta-integration</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.github.brunopacheco1</groupId>
            <artifactId>praecepta-spring-boot-starter</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.github.brunopacheco1</groupId>
            <artifactId>praecepta-micronaut</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.github.brunopacheco1</groupId>
            <artifactId>praecepta-quarkus</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.github.brunopacheco1</groupId>
            <artifactId>praecepta-quarkus-deployment</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!--
                    src/it/*-app are user projects, built with the Maven running this build, natively, and run
                    (-Dinvoker.test=spring-boot-app builds one). Each needs GraalVM's native-image: on GraalVM for
                    JDK 21, the applications whose framework needs a later one are skipped (invoker.java.version).
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <version>${maven-invoker-plugin.version}</version>
                <configuration>
                    <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
                    <localRepositoryPath>${project.build.directory}/it-repo</localRepositoryPath>
                    <settingsFile>src/it/settings.xml</settingsFile>
                    <pomIncludes>
                        <pomInclude>*-app/pom.xml</pomInclude>
                    </pomIncludes>
                    <!-- a native build is long: its progress shows as it runs, not only when it fails -->
                    <streamLogs>true</streamLogs>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>install</goal>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
