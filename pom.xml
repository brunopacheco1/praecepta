<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.brunopacheco1</groupId>
    <artifactId>praecepta</artifactId>
    <packaging>pom</packaging>
    <version>0.7.0-SNAPSHOT</version>
    <name>praecepta</name>
    <description>DMN decision tables for Java: strict hit policies, bitset matching, build-time validation.</description>
    <url>https://github.com/brunopacheco1/praecepta</url>
    <inceptionYear>2022</inceptionYear>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>brunopacheco1</id>
            <name>Bruno Pacheco</name>
            <url>https://github.com/brunopacheco1</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/brunopacheco1/praecepta.git</connection>
        <developerConnection>scm:git:git@github.com:brunopacheco1/praecepta.git</developerConnection>
        <url>https://github.com/brunopacheco1/praecepta</url>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/brunopacheco1/praecepta/issues</url>
    </issueManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- reproducible builds: fixed timestamps in every archive; the release process updates it -->
        <project.build.outputTimestamp>2026-11-13T13:53:17Z</project.build.outputTimestamp>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <sonar.projectKey>brunopacheco1_praecepta</sonar.projectKey>
        <sonar.organization>brunopacheco1-github</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <!-- one SonarCloud project for all modules; the benchmarks and TCK runner are not published, so not analysed -->
        <sonar.exclusions>**/praecepta/benchmarks/**/*,**/praecepta/tck/**/*</sonar.exclusions>
        <!-- CI tooling under .github is analysed for bugs and security, but has no coverage target -->
        <sonar.coverage.exclusions>.github/**/*</sonar.coverage.exclusions>

        <!-- test libraries -->
        <junit.version>6.1.3</junit.version>
        <assertj-core.version>3.27.7</assertj-core.version>
        <jqwik.version>1.10.2</jqwik.version>
        <jazzer.version>0.30.0</jazzer.version>

        <!-- build plugins -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
        <jacoco-maven-plugin.version>0.8.16</jacoco-maven-plugin.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>14.4.0</checkstyle.version>
        <license-maven-plugin.version>5.1.2</license-maven-plugin.version>
        <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
        <!-- release (Maven Central) -->
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
        <versions-maven-plugin.version>2.24.0</versions-maven-plugin.version>
        <maven-invoker-plugin.version>3.10.1</maven-invoker-plugin.version>
        <!-- native images (#19): only the native-image test project uses them (praecepta-maven-plugin/src/it/native-app) -->
        <native-maven-plugin.version>1.1.18</native-maven-plugin.version>
        <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>

        <!-- Spring Boot starter (#20): its BOM is imported by praecepta-spring-boot-starter only -->
        <spring-boot.version>4.1.2</spring-boot.version>

        <!-- Micronaut module (#77): the Micronaut 4 platform BOM, imported by praecepta-micronaut alone
             (Micronaut 5 needs Java 25, above the project's Java 21 baseline) -->
        <micronaut-platform.version>4.10.24</micronaut-platform.version>

        <!-- Quarkus extension (#76): the BOM, imported by praecepta-quarkus and praecepta-quarkus-deployment
             only, and the extension's build plugin and annotation processor, released with it -->
        <quarkus.version>3.40.1.2</quarkus.version>

        <!-- Gradle plugin (#18) -->
        <!-- the Gradle API the plugin compiles against, redistributed on Maven Central by gradleplugins.dev
             (its last release); the plugin uses only API that Gradle 8.5 to 9 share -->
        <gradle-api.version>8.11.1</gradle-api.version>
        <!-- the Groovy that Gradle ${gradle-api.version} bundles; its in-process tests need more of it than the API -->
        <groovy.version>3.0.22</groovy.version>
        <!-- the Gradle version the functional tests run (-P gradle-functional); gradle-versions.yml sets others -->
        <gradle-functional.version>9.8.2</gradle-functional.version>
    </properties>

    <modules>
        <module>praecepta-engine</module>
        <module>praecepta-loader</module>
        <module>praecepta-compiler</module>
        <module>praecepta-integration</module>
        <module>praecepta-maven-plugin</module>
        <module>praecepta-gradle-plugin</module>
        <module>praecepta-gradle-plugin-marker</module>
        <module>praecepta-spring-boot-starter</module>
        <module>praecepta-micronaut</module>
        <module>praecepta-quarkus</module>
        <module>praecepta-quarkus-deployment</module>
        <module>praecepta-benchmarks</module>
        <module>praecepta-tck</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- JUnit's artifacts, each at junit.version, rather than an import of org.junit:junit-bom: this
                 dependencyManagement is published with every module, and a BOM import there makes every
                 consumer of a Praecepta POM resolve the BOM, although no published module uses JUnit (#98).
                 Being declared, not imported, they also take precedence over the JUnit versions the Spring
                 Boot, Micronaut and Quarkus BOMs manage. List any other JUnit artifact a test needs here. -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-params</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-commons</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-engine</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-launcher</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <!-- Converge Apache POI's transitive dependencies (poi vs commons-compress disagree). -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.22.0</version>
            </dependency>
            <dependency>
                <groupId>commons-codec</groupId>
                <artifactId>commons-codec</artifactId>
                <version>1.23.0</version>
            </dependency>
            <dependency>
                <!-- POI's own version, which an imported BOM (Quarkus') would otherwise lower to 2.26.0
                     (GHSA-qv9r-c865-cp47) -->
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>2.26.1</version>
            </dependency>
            <dependency>
                <!-- the fixed version: Quarkus' test framework brings 33.6.0 through maven-embedder
                     (GHSA-xxph-c9ww-hj94). Tests use it only; no published module depends on it. -->
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.7.2-jre</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj-core.version}</version>
            </dependency>
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik</artifactId>
                <version>${jqwik.version}</version>
            </dependency>
            <dependency>
                <!-- fuzz tests: regression runs in every build, fuzzing on a schedule (fuzz.yml) -->
                <groupId>com.code-intelligence</groupId>
                <artifactId>jazzer-junit</artifactId>
                <version>${jazzer.version}</version>
            </dependency>
            <!-- Gradle plugin (#18): the Gradle API (provided) and TestKit (test). Their POMs also ask for
                 groovy-all and kotlin-stdlib at runtime, which Gradle itself provides: the plugin compiles
                 against the API and Groovy (which its signatures mention), and its in-process tests
                 (ProjectBuilder) run with kotlin-stdlib too. -->
            <dependency>
                <groupId>dev.gradleplugins</groupId>
                <artifactId>gradle-api</artifactId>
                <version>${gradle-api.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.codehaus.groovy</groupId>
                        <artifactId>groovy-all</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-stdlib</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>dev.gradleplugins</groupId>
                <artifactId>gradle-test-kit</artifactId>
                <version>${gradle-api.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.codehaus.groovy</groupId>
                        <artifactId>groovy-all</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.codehaus.groovy</groupId>
                <artifactId>groovy-json</artifactId>
                <version>${groovy.version}</version>
            </dependency>
            <dependency>
                <groupId>org.codehaus.groovy</groupId>
                <artifactId>groovy-ant</artifactId>
                <version>${groovy.version}</version>
                <exclusions>
                    <!-- Ant's JUnit and ANTLR tasks and Groovydoc; a Gradle project needs only Ant itself -->
                    <exclusion>
                        <groupId>org.apache.ant</groupId>
                        <artifactId>ant-junit</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.apache.ant</groupId>
                        <artifactId>ant-antlr</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.codehaus.groovy</groupId>
                        <artifactId>groovy-groovydoc</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <showWarnings>true</showWarnings>
                        <compilerArgs>
                            <!-- every warning fails the build; "processing" only says that no
                                 annotation processor claimed the test annotations -->
                            <arg>-Xlint:all,-processing</arg>
                            <arg>-Werror</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <!-- keeps the engine's validation warnings, logged for every table a test builds, out of the build log -->
                            <java.util.logging.config.file>${maven.multiModuleProjectDirectory}/test-logging.properties</java.util.logging.config.file>
                            <!-- Apache POI, Camunda and Drools log through the Log4j API; without a provider it prints an error -->
                            <log4j.provider>org.apache.logging.log4j.simple.internal.SimpleProvider</log4j.provider>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- the release workflow sets the version from the tag: mvn versions:set -DnewVersion=... -->
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <format>XML</format>
                                <format>HTML</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- the code style in checkstyle.xml (CONTRIBUTING.md, "Code style"); fails the build early -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
                    <sourceDirectories>
                        <sourceDirectory>${project.build.sourceDirectory}</sourceDirectory>
                    </sourceDirectories>
                    <testSourceDirectories>
                        <testSourceDirectory>${project.build.testSourceDirectory}</testSourceDirectory>
                    </testSourceDirectories>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>warning</violationSeverity>
                </configuration>
                <executions>
                    <execution>
                        <id>code-style</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- SPDX headers on Java sources and POMs: `check` runs in verify, `mvn license:format` adds them -->
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-maven-plugin.version}</version>
                <configuration>
                    <!-- REUSE-IgnoreStart: the header template is not this file's licence -->
                    <licenseSets>
                        <licenseSet>
                            <inlineHeader>SPDX-FileCopyrightText: Bruno Pacheco

SPDX-License-Identifier: Apache-2.0</inlineHeader>
                            <includes>
                                <include>src/**/*.java</include>
                                <include>pom.xml</include>
                            </includes>
                        </licenseSet>
                    </licenseSets>
                    <!-- REUSE-IgnoreEnd -->
                    <mapping>
                        <java>SLASHSTAR_STYLE</java>
                    </mapping>
                    <strictCheck>true</strictCheck>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- CycloneDX SBOM per module (target/bom.json), attached to the build -->
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx-maven-plugin.version}</version>
                <configuration>
                    <projectType>library</projectType>
                    <outputFormat>json</outputFormat>
                    <outputName>bom</outputName>
                    <includeTestScope>false</includeTestScope>
                    <includeProvidedScope>false</includeProvidedScope>
                    <includeSystemScope>false</includeSystemScope>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>makeBom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            The framework integrations as GraalVM native executables (#99): praecepta-native-tests builds a Spring
            Boot, a Micronaut and a Quarkus application natively and runs them. Minutes per application and
            GraalVM's native-image needed, so only the native-frameworks workflow (native-frameworks.yml) enables it:
            mvn -P native-frameworks -pl praecepta-native-tests -am verify
        -->
        <profile>
            <id>native-frameworks</id>
            <modules>
                <module>praecepta-native-tests</module>
            </modules>
        </profile>
        <!--
            Maven Central release: sources, javadoc, GPG signatures, publication through the Central
            Portal. Used by .github/workflows/release.yml; see docs/RELEASING.md. Signing reads the
            key from MAVEN_GPG_KEY / MAVEN_GPG_PASSPHRASE (no gpg keyring needed).
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <configuration>
                            <!-- broken javadoc fails the release; undocumented members do not -->
                            <doclint>all,-missing</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <configuration>
                            <signer>bc</signer>
                            <bestPractices>true</bestPractices>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
