<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.brunopacheco1</groupId>
        <artifactId>praecepta</artifactId>
        <version>0.13.0-SNAPSHOT</version>
    </parent>
    <artifactId>praecepta-engine</artifactId>
    <packaging>jar</packaging>
    <name>praecepta-engine</name>
    <description>
        A DMN 1.5 engine for Java: decision tables with strict hit policies, bitset matching and validation, the
        FEEL language, and decision requirement graphs.
        No dependencies; a JPMS module (io.github.brunopacheco1.praecepta.engine).
    </description>
    <properties>
        <!-- JaCoCo adds its agent here; empty when it is skipped (see the surefire argLine) -->
        <argLine/>
        <!-- the tests capture the engine's System.Logger output through java.util.logging, which the module does not read -->
        <praecepta.test.reads>io.github.brunopacheco1.praecepta.engine=java.logging</praecepta.test.reads>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.code-intelligence</groupId>
            <artifactId>jazzer-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.children="append">
                                <arg>--add-modules</arg>
                                <arg>java.logging</arg>
                                <arg>--add-reads</arg>
                                <arg>${praecepta.test.reads}</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- @{argLine} keeps JaCoCo's agent -->
                    <argLine>@{argLine} --add-modules java.logging --add-reads ${praecepta.test.reads}</argLine>
                    <systemPropertyVariables>
                        <!-- ArchUnit (LayeringTest) logs through SLF4J, which says on stderr that it has no provider -->
                        <slf4j.internal.verbosity>ERROR</slf4j.internal.verbosity>
                    </systemPropertyVariables>
                    <excludes>
                        <exclude>**/*$*</exclude>
                        <!-- run by the feel-stack execution, in a JVM of its own -->
                        <exclude>**/FeelExpressionStackTest.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- FEEL's stack bounds, checked in an interpreted JVM, whose frames are the largest a method has, so
                         that the check does not depend on the tests that ran before or on how warm the JIT is -->
                    <execution>
                        <id>feel-stack</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <!-- this test only, even with -Dtest on the command line, which would otherwise also run the
                                 tests it names here, interpreted, many times slower (#156) -->
                            <test>FeelExpressionStackTest</test>
                            <argLine>@{argLine} --add-modules java.logging --add-reads ${praecepta.test.reads} -Xint</argLine>
                            <excludes combine.self="override">
                                <exclude>**/*$*</exclude>
                            </excludes>
                            <includes combine.self="override">
                                <include>**/FeelExpressionStackTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!--
            Mutation testing with PIT (CONTRIBUTING.md, "Mutation testing"). Never part of the default build:
            ./mvnw -pl praecepta-engine -P mutation test-compile pitest:mutationCoverage
            -Dpit.targetClasses=... picks the classes to mutate (globs, separated by commas; the whole engine takes hours),
            -Dpit.targetTests=... the tests to run against them, -Dpit.threads=... the number of test JVMs.
            The report is target/pit-reports/index.html.
        -->
        <profile>
            <id>mutation</id>
            <properties>
                <pit.targetClasses>io.github.brunopacheco1.praecepta.engine.*</pit.targetClasses>
                <pit.targetTests>io.github.brunopacheco1.praecepta.engine.*</pit.targetTests>
                <pit.threads>4</pit.threads>
                <!-- more test classes to leave out, as a glob: '**.*PropertiesTest' drops the property-based tests,
                     which makes a run several times faster and its score lower -->
                <pit.excludedTestClasses>none.*</pit.excludedTestClasses>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest-maven.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5-plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <!-- as text, not as <param> elements, so that Maven splits a comma-separated list -->
                            <targetClasses>${pit.targetClasses}</targetClasses>
                            <targetTests>${pit.targetTests}</targetTests>
                            <excludedTestClasses>
                                <!-- fuzz tests replay saved inputs through Jazzer's agent, which PIT's test JVMs do not have -->
                                <param>**.*FuzzTest</param>
                                <param>**.*Fuzzer</param>
                                <!-- needs an interpreted JVM of its own (the feel-stack execution of surefire) -->
                                <param>**.FeelExpressionStackTest</param>
                                <param>${pit.excludedTestClasses}</param>
                            </excludedTestClasses>
                            <mutators>
                                <mutator>DEFAULTS</mutator>
                            </mutators>
                            <threads>${pit.threads}</threads>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>XML</outputFormat>
                            </outputFormats>
                            <failWhenNoMutations>false</failWhenNoMutations>
                            <jvmArgs>
                                <jvmArg>-Xmx768m</jvmArg>
                                <jvmArg>-Djava.util.logging.config.file=${maven.multiModuleProjectDirectory}/test-logging.properties</jvmArg>
                            </jvmArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>