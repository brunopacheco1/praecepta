<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.brunopacheco1</groupId>
        <artifactId>praecepta</artifactId>
        <version>0.8.0-SNAPSHOT</version>
    </parent>
    <artifactId>praecepta-compiler</artifactId>
    <packaging>jar</packaging>
    <name>praecepta-compiler</name>
    <description>
        The build-time core shared by the Maven plugin, the Gradle plugin and the Quarkus extension: loads
        Excel, CSV and DMN decision tables, validates them, converts them to DMN and generates typed
        input/output records and a decision class. Independent of any build tool.
    </description>
    <dependencies>
        <dependency>
            <groupId>io.github.brunopacheco1</groupId>
            <artifactId>praecepta-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.brunopacheco1</groupId>
            <artifactId>praecepta-loader</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- the frameworks' map-based engines, which must agree with the generated classes -->
        <dependency>
            <groupId>io.github.brunopacheco1</groupId>
            <artifactId>praecepta-integration</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- stable module name; no module-info because the loader (Apache POI) has none -->
                            <Automatic-Module-Name>io.github.brunopacheco1.praecepta.compiler</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
