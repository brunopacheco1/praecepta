<?xml version="1.0" encoding="UTF-8"?>
<!-- A decision table beside a business knowledge model, which DmnReader.readModel rejects (0.10, #118): the table loads alone -->
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/" id="later" name="later" namespace="https://example.com/later">
  <businessKnowledgeModel id="bkm" name="Rate"/>
  <decision id="tier" name="Tier">
    <decisionTable hitPolicy="FIRST">
      <input><inputExpression typeRef="number"><text>age</text></inputExpression></input>
      <output name="tier" typeRef="string"/>
      <rule><inputEntry><text>&lt; 18</text></inputEntry><outputEntry><text>"junior"</text></outputEntry></rule>
      <rule><inputEntry><text>&gt;= 18</text></inputEntry><outputEntry><text>"adult"</text></outputEntry></rule>
    </decisionTable>
  </decision>
</definitions>
