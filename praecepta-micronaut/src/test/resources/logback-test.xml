<!-- Micronaut's own warnings and errors go to the console; the tables' warnings and the module's INFO lines,
     logged on purpose by the tests, only reach the appenders the tests attach to read them -->
<configuration>
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="io.github.brunopacheco1.praecepta" level="INFO" additivity="false"/>
    <root level="WARN">
        <appender-ref ref="console"/>
    </root>
</configuration>
