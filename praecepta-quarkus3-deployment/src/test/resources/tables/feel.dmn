<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/" id="feel" name="Feel" namespace="https://example.com/feel">
  <!-- decision tables in the full FEEL language (#116): a computed column, cells beyond the simple unary tests, and output
       entries of several types, read by a literal expression -->
  <inputData id="age" name="Age"><variable name="Age" typeRef="number"/></inputData>
  <inputData id="limit" name="Limit"><variable name="Limit" typeRef="number"/></inputData>
  <decision id="band" name="Band">
    <informationRequirement><requiredInput href="#age"/></informationRequirement>
    <informationRequirement><requiredInput href="#limit"/></informationRequirement>
    <decisionTable hitPolicy="FIRST">
      <input><inputExpression><text>Age * 12</text></inputExpression></input>
      <output/>
      <rule><inputEntry><text>&gt; Limit * 12</text></inputEntry><outputEntry><text>"over the limit"</text></outputEntry></rule>
      <rule><inputEntry><text>? &gt;= 216 and ? &lt;= Limit * 12</text></inputEntry><outputEntry><text>Age * 12</text></outputEntry></rule>
      <rule><inputEntry><text>-</text></inputEntry><outputEntry><text>[Age, Limit]</text></outputEntry></rule>
    </decisionTable>
  </decision>
  <decision id="summary" name="Summary"><variable name="Summary" typeRef="boolean"/>
    <informationRequirement><requiredDecision href="#band"/></informationRequirement>
    <literalExpression><text>Band instance of number</text></literalExpression>
  </decision>
</definitions>
