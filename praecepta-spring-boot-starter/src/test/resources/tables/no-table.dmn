<?xml version="1.0" encoding="UTF-8"?>
<!-- A DMN model with input data but no decision (a literal expression decision would be one: #14). -->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="literal" name="Literal" namespace="http://example.com/tables">
  <inputData id="answer" name="Answer">
    <variable name="Answer" typeRef="number"/>
  </inputData>
</definitions>
